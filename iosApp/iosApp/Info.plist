<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Noise Meter</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>The microphone is used to measure how loud your surroundings are. Nothing is recorded or stored.</string>
	<!-- Lets Compose animate at 120 Hz on ProMotion iPhones. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- The app is always dark, so keep the status bar content light in both system themes. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
